<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            layout="@layout/tab_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Must come AFTER tab_chat: tab_chat's outer FrameLayout is always visible and opaque, so anything placed before it is hidden. -->
        <include
            layout="@layout/tab_conversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            layout="@layout/tab_compare"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            layout="@layout/tab_keys"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>