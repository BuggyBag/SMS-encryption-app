<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabCompare"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <!-- Fila 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBench"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_bench"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelfTest"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_selftest"
            android:textAllCaps="false"
            android:textColor="@color/secondary_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/secondary_bg"
            app:cornerRadius="12dp"
            app:strokeColor="@color/secondary_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSizes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_sizes"
            android:textAllCaps="false"
            android:textColor="@color/secondary_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/secondary_bg"
            app:cornerRadius="12dp"
            app:strokeColor="@color/secondary_border"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Fila 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportRaw"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_export_raw"
            android:textAllCaps="false"
            android:textColor="@color/secondary_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/secondary_bg"
            app:cornerRadius="12dp"
            app:strokeColor="@color/secondary_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportSummary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_export_summary"
            android:textAllCaps="false"
            android:textColor="@color/secondary_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/secondary_bg"
            app:cornerRadius="12dp"
            app:strokeColor="@color/secondary_border"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbLive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/cb_live"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        app:buttonTint="@color/accent" />

    <ProgressBar
        android:id="@+id/pbBench"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressBackgroundTint="@color/border_field"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_status"
        android:minHeight="40dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="Ready."
        android:textColor="@color/status_text"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_chat"
        android:fillViewport="true"
        android:padding="16dp"
        android:scrollbars="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal">

            <TextView
                android:id="@+id/tvCompare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="No benchmark data yet - tap Benchmark."
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>