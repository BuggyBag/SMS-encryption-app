<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <!-- ============ TAB CHAT ============ -->
    <LinearLayout
        android:id="@+id/tabChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <Spinner
            android:id="@+id/spMode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_field"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:popupBackground="@color/bg_field"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field"
            android:hint="@string/hint_phone"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_status"
            android:lineSpacingExtra="2dp"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="@string/status_enter_phone"
            android:textColor="@color/status_text"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_verify"
                android:textAllCaps="false"
                android:textColor="@color/accent_text"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestart"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_restart"
                android:textAllCaps="false"
                android:textColor="@color/secondary_text"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/secondary_bg"
                app:cornerRadius="12dp"
                app:strokeColor="@color/secondary_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_retry"
                android:textAllCaps="false"
                android:textColor="@color/secondary_text"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/secondary_bg"
                app:cornerRadius="12dp"
                app:strokeColor="@color/secondary_border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat"
            android:fillViewport="true"
            android:padding="16dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="@string/hint_message"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:minHeight="80dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_send"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent"
            app:cornerRadius="16dp" />
    </LinearLayout>
</FrameLayout>